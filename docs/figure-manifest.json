{
  "schema_version": "1.1",
  "project": "engineering-audit",
  "figures": [
    {
      "id": "boundary-condition-modulus",
      "status": "current",
      "evidence_type": "computed analytic verification example, not physical validation",
      "generator": "matlab/make_boundary_condition.m",
      "data_export": "studies/evidence_sufficiency/plot.py",
      "style": "matlab/fig_style.m",
      "command": "python -m studies.evidence_sufficiency.plot && matlab -batch \"addpath matlab; render_figures\"",
      "renderer": "MATLAB R2025b",
      "inputs": [
        "reports/evidence-sufficiency/results.json",
        "studies/evidence_sufficiency/spec.json"
      ],
      "outputs": [
        "reports/evidence-sufficiency/boundary-condition-data.csv",
        "reports/evidence-sufficiency/boundary-condition.png",
        "reports/evidence-sufficiency/boundary-condition.pdf",
        "reports/evidence-sufficiency/boundary-condition.svg",
        "reports/evidence-sufficiency/boundary-condition.caption.md"
      ],
      "units": {
        "stress": "MPa",
        "extension": "mm",
        "reaction": "N"
      },
      "caption": "Seeded development example, not physical validation. Six panels show the stored stress [MPa], extension [mm] and reaction [N] for the control (blue circles) and the half-modulus artifact (orange squares). Panels (a) to (c): prescribed force, 1000 N. Panels (d) to (f): prescribed displacement, 0.025 mm. The dotted grey line is the independent specification reference. A filled marker means the panel's check passes against that reference; a hollow marker means it fails. Under prescribed force only the extension check detects the fault; under prescribed displacement the stress and reaction checks detect the fault. Both half-modulus artifacts fail the full response tuple. Uniform axial bar, 100 mm long, 20 mm² section; one deterministic artifact per point, so there are no error bars. Values: matrix.md. Sources: results.json and spec.json."
    },
    {
      "id": "legacy-cad-contours-and-deformation",
      "status": "history",
      "evidence_type": "visualization of original numerical solves, not independent evidence",
      "inputs": [
        "cadloop/fea/runs"
      ],
      "index": "docs/history/README.md"
    },
    {
      "id": "legacy-audit-pipeline",
